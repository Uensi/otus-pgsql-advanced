changed: [bench-vm-01] => (item=0) => changed=true
  ansible_loop_var: item
  cmd: |-
    /usr/local/bin/clickhouse local --query "
    SELECT
        event_id,
        1 + event_id % 1000000 AS user_id,
        toDateTime('2025-01-01 00:00:00') + (event_id % 51840000) AS event_time,
        ['view','search','click','cart','purchase','refund','login','logout'][1 + event_id % 8] AS event_type,
        1 + event_id % 1000 AS category_id,
        100 + event_id % 1000000 AS price_cents,
        concat(
            leftPad(lower(hex(event_id)), 16, '0'),
            leftPad(lower(hex(event_id * 7)), 16, '0'),
            leftPad(lower(hex(event_id * 13)), 16, '0'),
            leftPad(lower(hex(event_id * 31)), 16, '0')
        ) AS payload
    FROM
    (
        SELECT 0 + number AS event_id
        FROM numbers(10000000)
    )
    FORMAT CSV
    " > /var/bench/data/events_0.csv
