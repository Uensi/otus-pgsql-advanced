TASK [Generate users.csv] **************************************************************************************************************************************************************************************************************************************************************
changed: [bench-vm-01] => changed=true
  cmd: |-
    /usr/local/bin/clickhouse local --query "
    SELECT
        number + 1 AS user_id,
        18 + number % 50 AS age,
        ['RU','US','DE','FR','CN','IN','BR','TR'][1 + number % 8] AS country_code,
        toDate('2020-01-01') + number % 1500 AS signup_date
    FROM numbers(1000000)
    FORMAT CSV
    " > /var/bench/data/users.csv
  delta: '0:00:00.163613'
