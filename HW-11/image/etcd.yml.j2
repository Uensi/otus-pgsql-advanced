name: {{ inventory_hostname }}
data-dir: {{ etcd_data_dir }}

listen-peer-urls: "http://{{ private_ip }}:{{ etcd_peer_port }}"
initial-advertise-peer-urls: "http://{{ private_ip }}:{{ etcd_peer_port }}"

listen-client-urls: "http://{{ private_ip }}:{{ etcd_client_port }},http://127.0.0.1:{{ etcd_client_port }}"
advertise-client-urls: "http://{{ private_ip }}:{{ etcd_client_port }}"

initial-cluster-token: {{ patroni_scope }}-etcd
initial-cluster: "{% for host in groups['ha_cluster'] %}{{ host }}=http://{{ hostvars[host]['private_ip'] }}:{{ etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}"
initial-cluster-state: new
