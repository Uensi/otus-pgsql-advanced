# /etc/patroni-console/env (0640 root:patroni-console). Создаётся deploy/install.sh; здесь — что в нём должно быть.
PATRONI_CONSOLE_SECRET=<≥32 случайных символов: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'>
PATRONI_CONSOLE_BIND=0.0.0.0:8443
PATRONI_CONSOLE_CERT=/etc/patroni-console/tls/console.crt
PATRONI_CONSOLE_KEY=/etc/patroni-console/tls/console.key
PATRONI_REST_PASSWORD=<console-itest.sh берёт из /etc/itest/patroni.env>
ETCD_PASSWORD=
